# Copy this to .env and fill in your credentials.
# Never commit .env to version control.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ─── Daily email report ───────────────────────────────────────────────────────
# Sender: bac@brindco.com via Gmail SMTP (smtp.gmail.com:465). brindco.com is Google
# Workspace — its MX is aspmx.l.google.com. This header used to say Microsoft 365; that
# was always wrong, the code and the DNS both say Google.
# SMTP_PASSWORD: a Google app password for that mailbox, generated at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_USER=bac@brindco.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ONE controlling list for all three BAC daily reports (this one, nse-announcements and
# the morning brief): the bac-reports@brindco.com Google Group. Add or remove a reader
# at groups.google.com -> My groups -> BAC Reports -> Members, not by editing this value
# in three repositories. BAC-Brindco is a personal GitHub account, so organisation-level
# secrets do not exist here; the shared mail transport is the only common ground.
REPORT_RECIPIENTS=bac-reports@brindco.com
REPORT_SENDER_NAME=BAC Daily Deals

# ─── Weekly email report ─────────────────────────────────────────────────────
# Saturday 10:00 IST, covering the Mon-Fri week just finished. Shares SMTP_USER,
# SMTP_PASSWORD and REPORT_RECIPIENTS with the daily above — the weekly goes to
# the same Google Group, so there is no separate recipient secret to keep in
# sync. Only the display name differs, so a reader can tell the two apart in a
# threaded inbox.
REPORT_WEEKLY_SENDER_NAME=BAC Weekly Deals
# Companies the email body covers per section, largest by market cap first.
# Default 10, matching the daily's REPORT_FOCUS_TOP_N.
# REPORT_WEEKLY_FOCUS_TOP_N=10
# How far back "first appearance" looks before calling a name or client new.
# Default 4 weeks. Shorter makes the section noisier, not more sensitive.
# REPORT_WEEKLY_LOOKBACK_WEEKS=4
# Rupee crore a first appearance must carry before the email body reports it.
# Default 100. Roughly half the names in any week are absent from a 4-week
# window — mostly one-session block participants — so without a floor the
# section is a census of the long tail rather than a signal. The comprehensive
# PDF ignores the floor and lists every absent name.
# REPORT_WEEKLY_FIRST_MIN_CR=100

# ─── Slack (optional) ────────────────────────────────────────────────────────
# Incoming webhook URL for the #daily-deals-nse channel.
# Create at: api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook
# If blank, Slack posting is skipped silently.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx

# Optional: residential/SOCKS5 proxy to bypass NSE IP blocking on cloud runners
# e.g. socks5h://user:pass@proxy-host:1080  or  http://user:pass@proxy-host:8080
# NSE_PROXY_URL=
